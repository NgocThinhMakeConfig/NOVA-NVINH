# ============================================
# NOVA KEY SERVER — LOCAL DEVELOPMENT
# File này KHÔNG được push lên GitHub
# ============================================

PORT=3000
NODE_ENV=development

# PostgreSQL local (nếu có) hoặc dùng Render DB
# Ví dụ: postgresql://postgres:123456@localhost:5432/nova
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Random 64 ký tự — tạo bằng lệnh bên dưới
JWT_SECRET=thay_bang_chuoi_random_64_ky_tu_o_day_abc123def456ghi789jkl012mno345pqr678
JWT_EXPIRES_IN=24h

# Mật khẩu admin — BẮT BUỘC đổi trước khi deploy
ADMIN_SECRET=AdminNova2025@Local

# Cho phép cả localhost (dev) và Render (sau này)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,*

# Bật/tắt khoá thiết bị
DEVICE_LOCK_ENABLED=false
